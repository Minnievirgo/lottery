{
  "name": "lottery-app",
  "version": "1.1.0",
  "description": "抽签软件 - Node.js 内置 http；本地 SQLite 或 Turso 云端持久库双后端",
  "main": "server.js",
  "scripts": {
    "start": "node --experimental-sqlite server.js",
    "migrate:turso": "node --experimental-sqlite migrate-to-turso.js",
    "migrate:cloudbase": "node migrate-to-cloudbase.js",
    "build:cloudbase": "node build-cloudbase.js",
    "test": "node --experimental-sqlite selftest.js",
    "test:cloudbase": "node -e \"process.env.CLOUDBASE_MOCK='1';process.env.SELFTEST_DRIVER='cloudbase';require('./selftest.js')\"",
    "test:http": "node -e \"process.env.DB_DRIVER='cloudbase';process.env.CLOUDBASE_MOCK='1';require('./selftest-http.js')\"",
    "test:server": "node selftest-server.js",
    "test:all": "npm test && npm run test:cloudbase && npm run test:http && npm run test:server"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "license": "MIT",
  "dependencies": {
    "@libsql/client": "^0.18.0"
  }
}
